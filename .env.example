# ─── Server ───────────────────────────────────────────────────────────────
# HTTP port the server listens on. Defaults to 3000.
PORT=3000
# "development" enables schema auto-sync, verbose logging, and plaintext DB.
# Set to "production" in any real environment.
NODE_ENV=development

# ─── Database (PostgreSQL / Supabase) ─────────────────────────────────────
# REQUIRED. The server will refuse to boot if any of these are missing
# (except DB_PORT which defaults to 5432).
DB_HOST=your-db-host.supabase.co
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your-password
DB_DATABASE=postgres

# ─── Auth (JWT) ───────────────────────────────────────────────────────────
# REQUIRED. Use a long random string (e.g. `openssl rand -hex 48`).
# The server refuses to boot if this is unset.
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# ─── Frontend ─────────────────────────────────────────────────────────────
# Used for CORS, OAuth redirects, and links inside outbound emails.
FRONTEND_URL=http://localhost:3001

# ─── Supabase Storage (avatar + banner uploads) ───────────────────────────
# OPTIONAL as a feature, but if you set any of these, set all four.
# If unset, upload endpoints respond with 503 and the rest of the app runs.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional. Preferred for storage writes; falls back to the anon key.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DISPLAY_PICTURE_BUCKET=
SUPABASE_BANNER_BUCKET=

# ─── Email (Maileroo HTTP API) ────────────────────────────────────────────
# OPTIONAL. Without MAILEROO_API_KEY, outbound email is skipped (and the
# boot log will warn that email is disabled).
MAILEROO_API_KEY=
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=SyncBooker
# Absolute URL to a logo used in email templates. Falls back to a default
# icon served from FRONTEND_URL if unset.
EMAIL_LOGO_URL=

# ─── Google Calendar (optional OAuth) ─────────────────────────────────────
# OPTIONAL. Without these, users cannot connect Google Calendar; bookings
# still work, but no calendar events or Meet links are created on confirm.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# ─── AI assistant (Gemini) ────────────────────────────────────────────────
# OPTIONAL. Without GEMINI_API_KEY, AI copy/FAQ/event-type endpoints still
# respond but return no suggestions.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
